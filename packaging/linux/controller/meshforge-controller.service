# MeshForge controller - systemd SYSTEM unit, installed by the meshforge-controller
# .deb (V0.17 G2, D390). Do not edit this file: it is replaced on upgrade. Put
# local changes in a drop-in: `sudo systemctl edit meshforge-controller`.
#
# Runs as the system user `meshforge` (shared with the agent package) with:
#   config    /etc/meshforge/controller.toml       (MESHFORGE_CONFIG below)
#   state     /var/lib/meshforge/controller/       (CA, TLS, blobs, setup token)
#   database  /var/lib/meshforge/db/               (its own PostgreSQL 16, D390)
#   program   /opt/meshforge/controller/current -> <version>  (read-only)
#   logs      journalctl -u meshforge-controller   (+ PostgreSQL's in db/log/)

[Unit]
Description=MeshForge controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meshforge
Group=meshforge
# Q11: the install mode is set here, explicitly - never guessed from the disk.
Environment=MESHFORGE_INSTALL_MODE=system
Environment=MESHFORGE_CONFIG=/etc/meshforge/controller.toml
ExecStart=/opt/meshforge/controller/current/bin/meshforge-controller
Restart=always
RestartSec=5
# 4 = CONFIG_ERROR (bad settings, a database of another PostgreSQL major, an
# upgrade that failed and was rolled back - D393: restarting would only repeat
# it), 5 = CONFLICT.
RestartPreventExitStatus=4 5
# Stop: SIGTERM to the controller only - it drains, then stops its PostgreSQL
# (smart -> fast -> immediate shutdown); whatever is left after the timeout is
# SIGKILLed with the whole cgroup. Its PostgreSQL also gets SIGINT (fast
# shutdown) by itself if the controller dies (PR_SET_PDEATHSIG, D398).
KillMode=mixed
# shutdown_drain_s (5) + PostgreSQL smart 5 + fast 20 + immediate 5 + 30 margin
TimeoutStopSec=65
StandardOutput=journal
StandardError=journal

# Hardening (the same as the agent's, D386): the service writes only its state.
ProtectSystem=strict
ReadWritePaths=/var/lib/meshforge
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Files the controller and its database create are owner-only.
UMask=0077
# Deliberately NOT set: MemoryDenyWriteExecute=yes (PostgreSQL's JIT and the
# ML planner's libraries may map executable memory); SystemCallFilter= (the
# bundled PostgreSQL's syscall set is not ours to pin).

[Install]
WantedBy=multi-user.target
