#!/bin/sh
# meshforge-controller postinst (V0.17 G2, D390/D392/D393). Idempotent.
#
#  1. state folders (shared /var/lib/meshforge, the controller's own sub-folder);
#  2. /etc/meshforge/controller.toml if missing (listeners on the LAN address of
#     the default route; managed database);
#  3. `doctor` (a report: a failed check is printed, the install goes on);
#  4. ufw: if it is active, allow the "MeshForge Controller" profile (D389);
#  5. a new controller (no fabric CA): make the one-time setup token (D392,
#     Q20) - the link itself is never printed here: apt keeps maintainer-script
#     output in /var/log/apt/term.log (world-readable on many systems), so the
#     person is told to run `sudo meshforge-controller setup url` instead;
#  6. enable + start (install) or restart (upgrade: the controller backs up its
#     database before migrating and rolls back if it is not serving in time,
#     D393), then say what is true: running, waiting for setup, or failed;
#  7. (V0.17 G5, Q35) an upgrade that failed (the controller restored its
#     database and exited 4) switches back to the previous version kept by
#     preinst, which starts on the restored database.
set -eu

UNIT=meshforge-controller.service
CTL=/opt/meshforge/controller/current/bin/meshforge-controller
CONFIG=/etc/meshforge/controller.toml
STATE=/var/lib/meshforge/controller
MARKER=/var/lib/meshforge/db/schema-version.json
ROLLBACK_FAILED=/var/lib/meshforge/db/rollback-failed.json
say() { printf 'meshforge-controller: %s\n' "$*"; }
as_service() {
	runuser -u meshforge -- env MESHFORGE_INSTALL_MODE=system MESHFORGE_CONFIG="$CONFIG" "$CTL" "$@"
}

MF_OPT=/opt/meshforge/controller
MF_UNIT=$UNIT
MF_VERSION=@MF_VERSION@
export MF_OPT MF_UNIT MF_VERSION
# @meshforge-include upgrade.sh

# wait_ready <since>: a good start (setup mode too) rewrites the database
# marker after its health check (D393); a failed one exits (4 after an
# upgrade's restore). Sets $state: ready | failed | unknown.
wait_ready() {
	state=unknown
	i=0
	while [ "$i" -lt 120 ]; do
		if [ -e "$MARKER" ] && [ "$(stat -c %Y "$MARKER")" -ge "$1" ]; then
			state=ready
			return 0
		fi
		if [ "$(systemctl is-active "$UNIT" 2>/dev/null || true)" = failed ]; then
			state=failed
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
}

case "${1:-}" in
configure) ;;
abort-upgrade | abort-remove | abort-deconfigure) exit 0 ;;
*) exit 0 ;;
esac
previous="${2:-}"
REMOVED_MARK="$STATE/.package-removed"
fresh=0
if [ -z "$previous" ] || [ -e "$REMOVED_MARK" ]; then
	fresh=1
fi
rm -f "$REMOVED_MARK"
# V0.17 G5: `current` names this version from here on (Q39)
mf_upgrade_switch

# 1. state folders (never loosened if an admin tightened them further)
if [ ! -d /etc/meshforge ]; then
	install -d -m 0755 -o root -g root /etc/meshforge
fi
if [ ! -d /var/lib/meshforge ]; then
	install -d -m 0750 -o meshforge -g meshforge /var/lib/meshforge
else
	chown meshforge:meshforge /var/lib/meshforge
fi
if [ ! -d "$STATE" ]; then
	install -d -m 0700 -o meshforge -g meshforge "$STATE"
fi

# 2. settings
MESHFORGE_INSTALL_MODE=system "$CTL" setup init-config --path "$CONFIG" ||
	say "warning: could not write $CONFIG (see above)"

# 3. doctor (warnings are expected before the first start)
if ! as_service doctor; then
	say "warning: a check above FAILED; the controller may not start until it is fixed"
fi

# 4. firewall (only when ufw is active; we never enable a firewall)
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; then
	if ufw allow 'MeshForge Controller' >/dev/null; then
		say "firewall (ufw): allowed 'MeshForge Controller' (TCP 47100, 47101, 47110)"
	fi
fi

if [ ! -d /run/systemd/system ]; then
	say "systemd is not running here (container/chroot): service not started"
	mf_upgrade_done # nothing to check here, so nothing to switch back to
	exit 0
fi
systemctl daemon-reload

# 5. a controller without a fabric: the setup token (made before the start, so
#    the controller comes up in setup mode; its link is not printed - see above)
needs_setup=0
if [ ! -e "$STATE/ca/ca.crt" ]; then
	if as_service setup url >/dev/null 2>&1; then
		needs_setup=1
	else
		say "warning: could not make the setup link (run: sudo meshforge-controller setup url)"
	fi
fi

# 6. enable and (re)start
if [ "$fresh" -eq 1 ]; then
	systemctl enable "$UNIT" >/dev/null 2>&1 || systemctl enable "$UNIT"
elif ! systemctl is-enabled --quiet "$UNIT"; then
	say "upgraded; $UNIT is disabled, so it was left stopped (start: sudo systemctl enable --now $UNIT)"
	mf_upgrade_done # a stopped service cannot be checked: no automatic switch back
	exit 0
fi
started_at=$(date +%s)
systemctl restart "$UNIT" || true
wait_ready "$started_at"

case "$state" in
ready)
	mf_upgrade_done
	say "service $UNIT is running version $MF_VERSION (logs: journalctl -u meshforge-controller)"
	;;
failed)
	say "service $UNIT FAILED to start; see: journalctl -u meshforge-controller -n 80"
	if [ "$fresh" -eq 0 ]; then
		if [ -e "$ROLLBACK_FAILED" ] && [ "$(stat -c %Y "$ROLLBACK_FAILED")" -ge "$started_at" ]; then
			# G2: the restore itself failed - never start an older version on a
			# database in an unknown state; the record says what to do.
			say "after the upgrade failed, the database could NOT be restored from the backup taken before it"
			say "(see: sudo meshforge-controller db status - it names the backup to restore by hand"
			say " with: sudo meshforge-controller db restore <backup> --yes)."
			say "the previous version was NOT started (its database is not in a known state)."
		else
			say "after an upgrade the database was restored from the backup taken before it"
			from=$(mf_state_get from)
			if mf_upgrade_rollback "the controller did not start on version $MF_VERSION (see the log above)"; then
				rolled_at=$(date +%s)
				wait_ready "$rolled_at"
				if [ "$state" = ready ]; then
					mf_upgrade_rolled_back_ok
					say "UPGRADE FAILED - ROLLED BACK: the previous version $from runs again on the restored"
					say "database ($MF_OPT/current -> $(mf_current_target)); agents reconnect by themselves."
					say "Send the log above to the MeshForge team."
				else
					say "the rollback to $from did not start either (state: $state);"
					say "see: journalctl -u meshforge-controller -n 80 and sudo meshforge-controller db status"
				fi
			else
				say "no previous version was kept, so it could not switch back; fix the cause and"
				say "start it again (see: sudo meshforge-controller db status)."
			fi
		fi
	fi
	exit 0
	;;
*)
	say "service $UNIT is still starting after 120 s; see: journalctl -u meshforge-controller -f"
	;;
esac

if [ "$needs_setup" -eq 1 ]; then
	say ""
	say "Create your fabric: run this to get the one-time setup link, then open it"
	say "in a browser ON THIS COMPUTER:"
	say ""
	say "    sudo meshforge-controller setup url"
	say ""
else
	http=$(sed -n 's/^http_bind = "\(.*\)"$/\1/p' "$CONFIG" | head -n 1)
	if [ -n "$http" ]; then
		say "dashboard: https://$http/"
	fi
fi

exit 0
