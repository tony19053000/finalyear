#!/bin/sh
# meshforge-controller postrm (V0.17 G2, D393/Q9): `apt remove` keeps the fabric
# (CA, database, settings); `apt purge` removes the controller's state. The
# shared service user and folders go only when the agent package is not on this
# machine (its own purge removes them otherwise). Idempotent.
set -eu

UNIT=meshforge-controller.service

agent_known() {
	status=$(dpkg-query -W -f='${db:Status-Status}' meshforge-agent 2>/dev/null || true)
	[ -n "$status" ] && [ "$status" != not-installed ]
}

case "${1:-}" in
purge | remove)
	# V0.17 G5: the rollback copy and the upgrade records (not dpkg's files)
	rm -rf /opt/meshforge/controller/.previous /opt/meshforge/controller/.upgrade
	rm -f /opt/meshforge/controller/.current.*
	rmdir /opt/meshforge/controller /opt/meshforge 2>/dev/null || true
	;;
esac

case "${1:-}" in
purge)
	rm -rf /var/lib/meshforge/controller /var/lib/meshforge/db
	rm -f /etc/meshforge/controller.toml
	if ! agent_known; then
		rmdir /var/lib/meshforge /etc/meshforge 2>/dev/null || true
		if getent passwd meshforge >/dev/null; then
			userdel meshforge || true
		fi
		if getent group meshforge >/dev/null; then
			groupdel meshforge || true
		fi
	fi
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
		systemctl reset-failed "$UNIT" >/dev/null 2>&1 || true
	fi
	;;
remove)
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
		systemctl reset-failed "$UNIT" >/dev/null 2>&1 || true
	fi
	;;
abort-upgrade)
	# V0.17 G5: the new version's unpack failed and dpkg put the old files
	# back: the upgrade that preinst began is over (keep a copy that runs).
	rm -f /opt/meshforge/controller/.upgrade/state
	case "$(readlink /opt/meshforge/controller/current 2>/dev/null || true)" in
	.previous/*) ;;
	*) rm -rf /opt/meshforge/controller/.previous ;;
	esac
	;;
upgrade | failed-upgrade | abort-install | disappear) ;;
*) ;;
esac

exit 0
