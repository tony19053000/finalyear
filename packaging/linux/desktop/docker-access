#!/bin/sh
# MeshForge: give the agent service Docker access (V0.17 G3, Q12/Q24). Run by
# pkexec (polkit action org.meshforge.docker-access) from the owner's desktop,
# or by root directly. Adds the service user to the `docker` group (that group
# is root-equivalent - the reason it is never done by default) and restarts the
# service so it gets the group. Exit: 0 done, 3 no docker group, 4 not root.
set -eu
say() { printf 'meshforge docker-access: %s\n' "$*" >&2; }

if [ "$(id -u)" -ne 0 ]; then
	say "must run as root (use the MeshForge app-menu action, or sudo)"
	exit 4
fi
if ! getent group docker >/dev/null; then
	say "there is no docker group here: install Docker Engine first"
	exit 3
fi
if id -nG meshforge | tr ' ' '\n' | grep -qx docker; then
	say "the meshforge service already has Docker access"
else
	usermod -a -G docker meshforge
	say "added the meshforge service user to the docker group"
fi
if [ -d /run/systemd/system ]; then
	systemctl restart meshforge-agent.service
fi
exit 0
