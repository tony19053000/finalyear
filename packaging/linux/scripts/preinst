#!/bin/sh
# meshforge-agent preinst (V0.17 G1, D386): the service account and the admin
# group. Idempotent: every step checks first, so a re-run (upgrade, a failed
# install retried) changes nothing.
set -eu

# V0.17 G5 (Q35): an upgrade keeps the version that runs now in
# /opt/meshforge/.previous/<ver> so a failed upgrade can switch back to it.
MF_OPT=/opt/meshforge
MF_UNIT=meshforge-agent.service
MF_VERSION=@MF_VERSION@
export MF_OPT MF_UNIT MF_VERSION
# @meshforge-include upgrade.sh

case "${1:-}" in
install | upgrade)
	if ! getent group meshforge >/dev/null; then
		groupadd --system meshforge
	fi
	if ! getent passwd meshforge >/dev/null; then
		useradd --system --gid meshforge --home-dir /var/lib/meshforge \
			--no-create-home --shell /usr/sbin/nologin \
			--comment "MeshForge node agent" meshforge
	fi
	# Local console access (D391, used from G3): members may read its token.
	if ! getent group meshforge-admin >/dev/null; then
		groupadd --system meshforge-admin
	fi
	# V0.17 G3: the G1 path unit is gone (the service always runs now). Stop and
	# disable it while its file still exists, so no dangling link stays behind.
	if [ "${1:-}" = upgrade ] && [ -e /usr/lib/systemd/system/meshforge-agent.path ]; then
		if [ -d /run/systemd/system ]; then
			systemctl stop meshforge-agent.path >/dev/null 2>&1 || true
		fi
		systemctl disable meshforge-agent.path >/dev/null 2>&1 || true
	fi
	;;
abort-upgrade) ;;
*) ;;
esac

if [ "${1:-}" = upgrade ]; then
	mf_upgrade_begin
fi

exit 0
