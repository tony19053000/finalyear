#!/bin/sh
# meshforge-agent postrm (V0.17 G1, D393/Q9): `apt remove` keeps the laptop's
# identity, config and caches (re-installing brings the same node back);
# `apt purge` removes them and the service account (the account and the shared
# folders stay while meshforge-controller is on the machine). Idempotent.
set -eu

UNITS="meshforge-agent.service meshforge-agent.path"

# V0.17 G2: meshforge-controller may be on this machine too (same service
# user); its state (controller/, db/, controller.toml) is never ours to delete.
controller_known() {
	status=$(dpkg-query -W -f='${db:Status-Status}' meshforge-controller 2>/dev/null || true)
	[ -n "$status" ] && [ "$status" != not-installed ]
}

case "${1:-}" in
purge)
	# the console token folder (V0.17 G3) is the agent's alone
	rm -rf /run/meshforge-console
	if controller_known; then
		for entry in /var/lib/meshforge/* /var/lib/meshforge/.[!.]*; do
			case "${entry##*/}" in
			controller | db | '*' | '.[!.]*') ;;
			*) rm -rf "$entry" ;;
			esac
		done
		for entry in /etc/meshforge/* /etc/meshforge/.[!.]*; do
			case "${entry##*/}" in
			controller.toml | '*' | '.[!.]*') ;;
			*) rm -rf "$entry" ;;
			esac
		done
	else
		rm -rf /var/lib/meshforge /etc/meshforge
		if getent passwd meshforge >/dev/null; then
			userdel meshforge || true
		fi
		if getent group meshforge >/dev/null; then
			groupdel meshforge || true
		fi
	fi
	# meshforge-admin (console access, V0.17 G3) is the agent's alone: the
	# controller package neither creates nor uses it
	if getent group meshforge-admin >/dev/null; then
		groupdel meshforge-admin || true
	fi
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
		# shellcheck disable=SC2086 # two unit names
		systemctl reset-failed $UNITS >/dev/null 2>&1 || true
	fi
	;;
remove)
	# the console token folder (V0.17 G3): runtime only, empty once the service
	# stopped; its tmpfiles.d entry is gone, so nothing recreates it
	rm -f /run/meshforge-console/token
	rmdir /run/meshforge-console 2>/dev/null || true
	# the unit files are gone now; also forget a "failed" state systemd would
	# otherwise keep listing (lab/verify_uninstall.py checks for it)
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
		# shellcheck disable=SC2086 # two unit names
		systemctl reset-failed $UNITS >/dev/null 2>&1 || true
	fi
	;;
upgrade | failed-upgrade | abort-install | abort-upgrade | disappear) ;;
*) ;;
esac

exit 0
