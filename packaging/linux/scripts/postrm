#!/bin/sh
# meshforge-agent postrm (V0.17 G1, D393/Q9): `apt remove` keeps the laptop's
# identity, config and caches (re-installing brings the same node back);
# `apt purge` removes them and the service account. Idempotent.
set -eu

UNITS="meshforge-agent.service meshforge-agent.path"

case "${1:-}" in
purge)
	rm -rf /var/lib/meshforge /etc/meshforge /run/meshforge-console
	if getent passwd meshforge >/dev/null; then
		userdel meshforge || true
	fi
	for group in meshforge meshforge-admin; do
		if getent group "$group" >/dev/null; then
			groupdel "$group" || true
		fi
	done
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
		# shellcheck disable=SC2086 # two unit names
		systemctl reset-failed $UNITS >/dev/null 2>&1 || true
	fi
	;;
remove)
	# the console token folder (V0.17 G3): runtime only, empty once the service
	# stopped; its tmpfiles.d entry is gone, so nothing recreates it
	rm -f /run/meshforge-console/token
	rmdir /run/meshforge-console 2>/dev/null || true
	# the unit files are gone now; also forget a "failed" state systemd would
	# otherwise keep listing (lab/verify_uninstall.py checks for it)
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
		# shellcheck disable=SC2086 # two unit names
		systemctl reset-failed $UNITS >/dev/null 2>&1 || true
	fi
	;;
upgrade | failed-upgrade | abort-install | abort-upgrade | disappear) ;;
*) ;;
esac

exit 0
