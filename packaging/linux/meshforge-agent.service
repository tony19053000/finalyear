# MeshForge node agent - systemd SYSTEM unit, installed by the meshforge-agent
# .deb (V0.17 G1, D386). Do not edit this file: it is replaced on upgrade. Put
# local changes in a drop-in: `sudo systemctl edit meshforge-agent`.
#
# Runs as the system user `meshforge` with machine-wide state (D385):
#   config    /etc/meshforge/config.toml          (optional)
#   state     /var/lib/meshforge/{identity,envs,...}
#   program   /opt/meshforge/current -> <version>  (read-only)
#   logs      journalctl -u meshforge-agent
#
# Docker: `meshforge` is NOT in the `docker` group (that group is root-equivalent,
# Q12). Until the owner opts in, the agent reports "docker: no access" and runs
# jobs with the subprocess/venv runtimes. Opt in:
#   sudo usermod -aG docker meshforge && sudo systemctl restart meshforge-agent

[Unit]
Description=MeshForge node agent
# Only a hint: the controller is normally another laptop, and the agent retries
# for as long as it takes (ADR-0002 Updates section 3).
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meshforge
Group=meshforge
# Q11: the install mode is set here, explicitly - never guessed from the disk.
Environment=MESHFORGE_INSTALL_MODE=system
ExecStart=/opt/meshforge/current/bin/meshforge-agent run
Restart=always
RestartSec=5
# 4 = CONFIG_ERROR (a bad config file or a refused identity: retrying cannot fix
# it), 5 = CONFLICT (another agent owns this identity: restarting would fight it).
RestartPreventExitStatus=4 5
# Stop: SIGTERM to the agent only (it stops its jobs itself), then SIGKILL to
# everything left in the cgroup - no job process outlives the service.
KillMode=mixed
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Hardening. The agent is remote-code-execution machinery by design; the job
# sandboxing lives with the executor (V0.5/V0.7). These keep the service itself
# from writing anywhere but its own state.
ProtectSystem=strict
ReadWritePaths=/var/lib/meshforge
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

# V0.7 G6: the agent's own cgroup subtree, with the agent in the leaf "agent",
# so jobs of the unsandboxed runtimes get a real CPU cap (cpu.max per job).
# DelegateSubgroup needs systemd >= 254 (Ubuntu 24.04 has 255; 22.04's 249
# ignores it and the cap reports "not_enforced").
Delegate=yes
DelegateSubgroup=agent

[Install]
WantedBy=multi-user.target
