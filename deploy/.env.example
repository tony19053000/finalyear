# Copy to deploy/.env to override the dev database defaults (deploy/.env is git-ignored).
# These are DEV-ONLY values for a database bound to 127.0.0.1. Never put real secrets here.
#
# If you change any of these, tell the controller/Alembic the same values, e.g.
#   export MESHFORGE_DATABASE__PASSWORD=...   MESHFORGE_DATABASE__PORT=...
# (MeshForge settings do not read .env files.)
MESHFORGE_DEV_DB_NAME=meshforge
MESHFORGE_DEV_DB_USER=meshforge
MESHFORGE_DEV_DB_PASSWORD=meshforge-dev
MESHFORGE_DEV_DB_PORT=5432
