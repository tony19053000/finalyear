    {
      "name": "example",
      "text": "name: image-classify\nentrypoint: python train.py --epochs 3\nenv:\n  base: cuda-pytorch\n  python: \"3.12\"\n  requirements: requirements.txt\nresources:\n  gpu: preferred\n  vram_gb: 4\n  ram_gb: 8\n  cpus: 4\noutputs: [results/, \"*.csv\"]\ninputs:\n  - ref: imagenet-mini@3\n    mount: data/imagenet\nlimits:\n  timeout: 2h\n  network: none\npriority: 0\npolicy: cost_model\nretry:\n  max_attempts: 3\n  backoff_s: 5\n  on_lost: true\nsecrets:\n  - API_KEY\n  - {name: DB_PASS, as_env: true}\n",
      "expect": {
        "name": "image-classify",
        "entrypoint": "python train.py --epochs 3",
        "env": {
          "base": "cuda-pytorch",
          "python": "3.12",
          "requirements": "requirements.txt"
        },
        "resources": {
          "gpu": "preferred",
          "vram_gb": 4,
          "ram_gb": 8,
          "cpus": 4
        },
        "outputs": [
          "results/",
          "*.csv"
        ],
        "inputs": [
          {
            "ref": "imagenet-mini@3",
            "mount": "data/imagenet"
          }
        ],
        "limits": {
          "timeout": "2h",
          "network": "none"
        },
        "priority": 0,
        "policy": "cost_model",
        "retry": {
          "max_attempts": 3,
          "backoff_s": 5,
          "on_lost": true
        },
        "secrets": [
