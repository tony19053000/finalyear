      "PolicyValues": {
        "additionalProperties": false,
        "description": "The owner's live settings (``meshforge-agent policy`` keys). In a PUT,\nabsent keys stay as they are; ``null`` on a limit removes the limit.",
        "properties": {
          "accept_gpu_sessions": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accept Gpu Sessions"
          },
          "accept_jobs": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accept Jobs"
          },
          "allow_network": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Allow Network"
          },
          "allow_unsandboxed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Allow Unsandboxed"
          },
          "allowed_users": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 64,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Allowed Users"
          },
          "max_cpu_jobs": {
            "anyOf": [
              {
                "maximum": 64.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Cpu Jobs"
          },
          "max_cpu_percent": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Cpu Percent"
          },
          "max_gpu_jobs": {
            "anyOf": [
              {
                "maximum": 64.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Gpu Jobs"
          },
          "max_ram_bytes": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Ram Bytes"
          },
          "max_vram_bytes": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Vram Bytes"
          },
          "pause_benchmarks": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pause Benchmarks"
          }
        },
        "title": "PolicyValues",
        "type": "object"
      },
      "PolicyView": {
        "additionalProperties": false,
        "properties": {
          "cpu_threads": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cpu Threads"
          },
          "deprecated_keys": {
            "items": {
              "type": "string"
            },
