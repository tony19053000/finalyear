            "type": "array"
          },
          "max_cpu_jobs": {
            "title": "Max Cpu Jobs",
            "type": "integer"
          },
          "max_gpu_jobs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Gpu Jobs"
          },
