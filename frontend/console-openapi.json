            "type": "array"
          },
          "invalid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invalid"
          },
          "live_keys": {
            "items": {
              "type": "string"
            },
