                "type": "null"
              }
            ]
          },
          "upgrade": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UpgradeNoticeView"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
