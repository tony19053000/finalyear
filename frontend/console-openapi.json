            "title": "Owner Activity Guard",
            "type": "boolean"
          },
          "policy": {
            "additionalProperties": true,
            "title": "Policy",
            "type": "object"
          },
          "restart_needed": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Restart Needed",
            "type": "array"
          }
        },
        "required": [
          "policy",
          "max_cpu_jobs",
          "max_gpu_jobs",
          "live_keys",
          "invalid",
          "deprecated_keys",
          "owner_activity_guard",
